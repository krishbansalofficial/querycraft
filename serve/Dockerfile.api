# API image: CPU only (retriever encoders + LightGBM run on CPU; the GPU belongs to vLLM).
FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir --extra-index-url https://download.pytorch.org/whl/cpu torch==2.13.0+cpu \
 && pip install --no-cache-dir fastapi "uvicorn[standard]" prometheus-client opentelemetry-sdk \
    opentelemetry-exporter-otlp-proto-http httpx "transformers>=5.16.1,<5.20.0" sentence-transformers faiss-cpu \
    lightgbm scikit-learn joblib sqlglot pyyaml
COPY querycraft querycraft
COPY serve serve
COPY configs configs
EXPOSE 8000
CMD ["uvicorn", "serve.app:app", "--host", "0.0.0.0", "--port", "8000"]
